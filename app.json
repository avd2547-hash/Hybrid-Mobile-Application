{
  "expo": {
    "name": "Campus Events",
    "slug": "campus-events",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-kku.png",
    "scheme": "campusevents",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "อนุญาตให้ Campus Events เข้าถึงกล้องเพื่อถ่ายภาพประกอบกิจกรรม",
        "NSPhotoLibraryUsageDescription": "อนุญาตให้ Campus Events เข้าถึงคลังภาพเพื่อเลือกรูปภาพประกอบกิจกรรม",
        "NSLocationWhenInUseUsageDescription": "อนุญาตให้ Campus Events เข้าถึงตำแหน่งเพื่อระบุพิกัดสถานที่จัดกิจกรรม"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-kku.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-kku.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
